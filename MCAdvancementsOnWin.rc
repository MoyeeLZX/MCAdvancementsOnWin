#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
BLOCK "StringFileInfo"
BEGIN
BLOCK "040904b0"
BEGIN
VALUE "CompanyName", "mylzx@2btb.top"
VALUE "FileDescription", "MC Advancements on Windows"
VALUE "FileVersion", "beta-2026.8.7"
VALUE "InternalName", "MCAdvancementsOnWin"
VALUE "LegalCopyright", "MoyeeLZX 2026"
VALUE "OriginalFilename", "MCAdvancementsOnWin.exe"
VALUE "ProductName", "MC Advancements on Windows"
VALUE "ProductVersion", "beta-2026.8.7"
END
END
BLOCK "VarFileInfo"
BEGIN
VALUE "Translation", 0x0804, 1200
END
END
